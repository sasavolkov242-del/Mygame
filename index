<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">

<title>Для самой любимой ♡</title>
<style>
:root{
  --bg:#fff7fa; --card:#ffffff; --pink:#ef6f9b; --deep:#c94d78;
  --soft:#ffe3ed; --text:#3d2932; --muted:#8d6f79; --shadow:0 16px 45px rgba(196,85,123,.13);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
body{overflow-x:hidden}
.app{min-height:100vh;display:flex;justify-content:center}
.screen{width:min(680px,100%);min-height:100vh;padding:22px 18px 34px;display:flex;flex-direction:column}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}
.step{font-size:12px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}
h1{font-size:28px;line-height:1.12;margin:4px 0 10px;letter-spacing:-.03em}
h2{font-size:20px;margin:0 0 8px}
.instruction{color:var(--muted);font-size:15px;line-height:1.5;margin:0 0 18px}
.card{background:rgba(255,255,255,.86);border:1px solid rgba(239,111,155,.14);border-radius:26px;box-shadow:var(--shadow);padding:20px}
button{font:inherit;border:0;cursor:pointer}
.primary{width:100%;background:var(--pink);color:#fff;border-radius:18px;padding:15px 18px;font-weight:700;font-size:16px;box-shadow:0 10px 24px rgba(239,111,155,.25)}
.primary:active{transform:scale(.985)}
.secondary{background:#fff;color:var(--deep);border:1px solid #f2c6d5;border-radius:16px;padding:13px 17px;font-weight:700}
.center{margin:auto 0;display:flex;flex-direction:column;gap:18px}
.heart-field{position:relative;height:min(64vh,520px);min-height:410px;overflow:hidden;border-radius:28px;background:linear-gradient(145deg,#fff,#fff0f5);border:1px solid #f8dce6}
.heart{position:absolute;width:68px;height:61px;background:#f58aad;transform:rotate(-45deg);border-radius:12px 0 12px 0;display:flex;align-items:center;justify-content:center;transition:.22s ease;box-shadow:0 10px 22px rgba(239,111,155,.16)}
.heart:before,.heart:after{content:"";position:absolute;width:68px;height:61px;background:inherit;border-radius:50%}
.heart:before{top:-31px;left:0}.heart:after{top:0;left:31px}
.heart span{position:relative;z-index:2;transform:rotate(45deg);font-size:22px;color:#fff;font-weight:800}
.heart.open{opacity:0;pointer-events:none;transform:rotate(-45deg) scale(0);transition:opacity .25s ease,transform .25s ease}
.heart.open:before,.heart.open:after{background:inherit}
.heart.open span{font-size:0}
.message-pop{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);width:calc(100% - 30px);background:#fff;border-radius:18px;padding:13px 16px;text-align:center;color:var(--deep);font-weight:650;box-shadow:0 12px 30px rgba(78,35,48,.10);opacity:0;pointer-events:none;transition:.2s}
.message-pop.show{opacity:1}
.progress{font-size:13px;color:var(--muted);text-align:center;margin-top:12px}
.hidden{display:none!important}

.cat-area{position:relative;height:min(62vh,500px);min-height:400px;border-radius:28px;background:linear-gradient(145deg,#fff,#fff0f5);border:1px solid #f8dce6;overflow:hidden}
.cat{position:absolute;width:78px;height:78px;border-radius:50%;background:#fff;box-shadow:0 12px 30px rgba(87,44,57,.14);display:flex;align-items:center;justify-content:center;font-size:48px;transition:left .24s ease,top .24s ease;user-select:none}
.cat-hint{position:absolute;inset:auto 14px 14px;text-align:center;color:var(--muted);font-size:13px}
.cat-message{min-height:48px;margin-top:12px;border-radius:16px;background:#fff;padding:12px 14px;text-align:center;color:var(--deep);font-weight:650;box-shadow:0 8px 20px rgba(78,35,48,.06)}

.puzzle{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;aspect-ratio:1;border-radius:18px;overflow:hidden;background:#fff;padding:5px}
.tile{background-image:url("data:image/png;base64,");background-repeat:no-repeat;border-radius:7px;position:relative;touch-action:manipulation}
.tile.selected{outline:3px solid #ef6f9b;outline-offset:-3px;z-index:2}
.tile-num{position:absolute;right:4px;top:4px;width:20px;height:20px;border-radius:50%;background:rgba(255,255,255,.82);font-size:11px;display:flex;align-items:center;justify-content:center;color:var(--deep)}
.puzzle-note{font-size:13px;color:var(--muted);text-align:center;margin:10px 0 0}
.success{background:#fff;border:1px solid #f5d7e2;border-radius:24px;padding:24px;text-align:center;box-shadow:var(--shadow)}
.big-heart{font-size:58px;line-height:1;margin-bottom:10px}
.success h2{font-size:25px;line-height:1.25}
.prizes{display:grid;gap:12px}
.prize{padding:18px;border-radius:20px;background:#fff;border:1.5px solid #f2cbd8;text-align:left;display:flex;gap:13px;align-items:center}
.prize.selected{border-color:#ef6f9b;background:#fff0f5;box-shadow:0 8px 22px rgba(239,111,155,.13)}
.prize .icon{font-size:28px}.prize strong{display:block;font-size:16px}.prize small{color:var(--muted);display:block;margin-top:3px}
.final{text-align:center;padding-top:15vh}.final .big{font-size:72px}
.final h1{font-size:32px}.final p{color:var(--muted);line-height:1.55}
.sparkles{position:fixed;inset:0;pointer-events:none;overflow:hidden}
.spark{position:absolute;font-size:18px;animation:float 4s linear forwards;opacity:0}
@keyframes float{0%{transform:translateY(15vh) scale(.7);opacity:0}15%{opacity:.75}100%{transform:translateY(-105vh) translateX(25px) scale(1.15);opacity:0}}
@media(max-width:380px){h1{font-size:25px}.heart-field,.cat-area{min-height:370px}.card{padding:16px}}
</style>
</head>
<body>
<div class="app"><main class="screen" id="app"></main></div>
<div class="sparkles" id="sparkles"></div>
<script>
const app=document.getElementById('app');
const sparkles=document.getElementById('sparkles');

const heartMessages=[
 "Ты моё самое тёплое счастье ♡","С тобой всё становится уютнее","Ты очень-очень красивая","Я всегда на твоей стороне","Мне нравится видеть твою улыбку","Ты заслуживаешь море нежности","Ты моё любимое чудо","Обнимаю тебя даже на расстоянии","Ты делаешь мой мир лучше","Я горжусь тобой","Ты невероятно мне дорога","Ещё одно маленькое «люблю» для тебя ♡"
];
const catMessages=[
 "Мяу! Поймала — держи нежность ♡",
 "Мяу-мяу! Ты у меня самая ловкая",
 "Вот тебе ещё одно тёплое «люблю»",
 "Не убежишь от моих обнимашек 😽",
 "Последний пойман! Ты чудо, любимая ♡"
];
let heartOpen=0, catCaught=0, catTimer=null, selectedPrize=null;

function layout(step,title,instruction,content,footer=""){
 app.innerHTML=`<div class="top"><div class="step">шаг ${step} из 3</div></div>
 <h1>${title}</h1><p class="instruction">${instruction}</p>${content}${footer}`;
}
function button(text,onclick,cls="primary"){return `<button class="${cls}" onclick="${onclick}">${text}</button>`}
function go(n){
 if(n===1) renderHearts();
 if(n===2) renderCat();
 if(n===3) renderPuzzle();
}
function renderHearts(){
 const placed=[];
 const hearts=heartMessages.map((_,i)=>{
   let left=8, top=6, tries=0;
   // Keep a generous gap so hearts never cover/crop one another.
   while(tries++<300){
     left=6+Math.random()*82; top=6+Math.random()*78;
     if(placed.every(p=>Math.hypot(left-p.left, (top-p.top)*1.35)>14)) break;
   }
   placed.push({left,top});
   const hue=345+Math.random()*25;
   return `<button class="heart" data-i="${i}" style="left:${left}%;top:${top}%;background:hsl(${hue} 78% ${68+Math.random()*8}%);" aria-label="Открыть сердечко"><span>♥</span></button>`
 }).join('');
 layout(1,"Открой все сердечки","Нажимай на каждое сердечко — внутри тебя ждёт маленькое сообщение 💗",
 `<div class="heart-field" id="heartField">${hearts}<div class="message-pop" id="heartMsg"></div></div>
 <div class="progress" id="heartProgress">Открыто: 0 / ${heartMessages.length}</div>
 <div id="next1" class="hidden" style="margin-top:14px">${button("Далее →","go(2)")}</div>`);
 document.querySelectorAll(".heart").forEach(el=>el.onclick=()=>{
   const i=+el.dataset.i;if(el.classList.contains("open"))return;
   el.classList.add("open");heartOpen++;
   const msg=document.getElementById("heartMsg");msg.textContent=heartMessages[i];msg.classList.add("show");
   document.getElementById("heartProgress").textContent=`Открыто: ${heartOpen} / ${heartMessages.length}`;
   if(heartOpen===heartMessages.length){document.getElementById("next1").classList.remove("hidden");}
 });
}

function renderCat(){
 layout(2,"Поймай котика","Котик убегает, но очень хочет сказать тебе что-нибудь милое. Поймай его 5 раз 😽",
 `<div class="cat-area" id="catArea"><button class="cat" id="cat">🐈</button><div class="cat-hint">тапни по котику</div></div>
 <div class="cat-message" id="catMessage">Поймано: 0 / 5</div>
 <div id="next2" class="hidden" style="margin-top:14px">${button("продолжаем, любимая?","go(3)")}</div>`);
 const area=document.getElementById("catArea"), cat=document.getElementById("cat");
 function move(){
   const r=area.getBoundingClientRect(), maxX=Math.max(8,r.width-90), maxY=Math.max(8,r.height-110);
   cat.style.left=(8+Math.random()*Math.max(0,maxX-8))+"px";
   cat.style.top=(8+Math.random()*Math.max(0,maxY-8))+"px";
 }
 function caught(e){
   e.preventDefault(); if(catCaught>=5)return;
   catCaught++;
   document.getElementById("catMessage").textContent=catMessages[catCaught-1];
   if(catCaught===5){document.getElementById("next2").classList.remove("hidden");clearInterval(catTimer);}
   else move();
 }
 cat.addEventListener("click",caught);
 move(); catTimer=setInterval(()=>{if(catCaught<5)move()},900);
}

const PHOTO_DATA="data:image/png;base64,";
let puzzleOrder=[];
function renderPuzzle(){
 puzzleOrder=[0,1,2,3,4,5,6,7,8];
 do{puzzleOrder.sort(()=>Math.random()-.5)}while(isSolved());
 layout(3,"Собери нашу фотографию","Нажимай на две детали по очереди, чтобы поменять их местами. Пазл простой — у тебя точно получится ♡",
 `<div class="card"><div class="puzzle" id="puzzle"></div><p class="puzzle-note">Выбери две детали — они поменяются местами.</p></div>
 <div id="puzzleSuccess" class="hidden" style="margin-top:16px"></div>`);
 drawPuzzle();
}
function isSolved(){return puzzleOrder.every((v,i)=>v===i)}
function drawPuzzle(){
 const p=document.getElementById("puzzle"); if(!p)return;
 p.innerHTML="";
 puzzleOrder.forEach((piece,pos)=>{
   const tile=document.createElement("button");tile.className="tile";tile.dataset.pos=pos;
   const col=piece%3,row=Math.floor(piece/3);
   tile.style.backgroundImage=`url("${PHOTO_DATA}")`;tile.style.backgroundSize="300% 300%";tile.style.backgroundPosition=`${col*50}% ${row*50}%`;
   tile.innerHTML=`<span class="tile-num">${pos+1}</span>`;
   tile.onclick=()=>selectTile(pos);
   p.appendChild(tile);
 });
}
let first=null;
function selectTile(pos){
 const tiles=[...document.querySelectorAll(".tile")];
 if(first===null){first=pos;tiles[pos].classList.add("selected");return}
 if(first===pos){tiles[pos].classList.remove("selected");first=null;return}
 [puzzleOrder[first],puzzleOrder[pos]]=[puzzleOrder[pos],puzzleOrder[first]];
 first=null;drawPuzzle();
 if(isSolved())showPuzzleSuccess();
}
function showPuzzleSuccess(){
 const box=document.getElementById("puzzleSuccess");
 box.classList.remove("hidden");
 box.innerHTML=`<div class="success"><div class="big-heart">♡</div><h2>Ты умничка, ты снова справилась, горжусь тобой</h2>
 <div style="margin-top:18px">${button("получить приз","showPrizes()")}</div></div>`;
 box.scrollIntoView({behavior:"smooth",block:"center"});
}
function showPrizes(){
 layout("♡","Выбери свой приз","Можно выбрать только один. Но любой из них — от всего сердца.",
 `<div class="prizes">
  <button class="prize" onclick="choosePrize(this,'мои 1000 обнимашек')"><span class="icon">🤗</span><span><strong>Мои 1000 обнимашек</strong><small>самых крепких и тёплых</small></span></button>
  <button class="prize" onclick="choosePrize(this,'мои 1000 поцелуев')"><span class="icon">💋</span><span><strong>Мои 1000 поцелуев</strong><small>один за другим, без очереди</small></span></button>
  <button class="prize" onclick="choosePrize(this,'мои 1000 нежностей')"><span class="icon">💕</span><span><strong>Мои 1000 нежностей</strong><small>для тебя — сколько захочешь</small></span></button>
 </div>
 <div id="prizeAction" class="hidden" style="margin-top:16px">${button("Забираю ♡","finishPrize()")}</div>`);
}
function choosePrize(el,name){
 document.querySelectorAll(".prize").forEach(x=>x.classList.remove("selected"));
 el.classList.add("selected");selectedPrize=name;
 document.getElementById("prizeAction").classList.remove("hidden");
}
function finishPrize(){
 layout("♡","Приз твой","И помни: это только маленькое напоминание о том, как сильно ты мне дорога.",
 `<div class="final"><div class="big">💗</div><h1>${selectedPrize}</h1><p>Всё это — специально для тебя.<br>Подойди поближе, любимая. Я уже обнимаю тебя мысленно.</p>
 <div style="margin-top:22px">${button("Начать сначала","go(1)")}</div></div>`);
 for(let i=0;i<18;i++) setTimeout(()=>spawnSpark(),i*100);
}
function spawnSpark(){
 const s=document.createElement("span");s.className="spark";s.textContent=["♡","♥","✦","💕"][Math.floor(Math.random()*4)];
 s.style.left=(Math.random()*100)+"%";s.style.top=(70+Math.random()*35)+"%";s.style.animationDuration=(3+Math.random()*2)+"s";
 sparkles.appendChild(s);setTimeout(()=>s.remove(),5200);
}
go(1);
</script>
</body>
</html>
